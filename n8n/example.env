# Copy to n8n/.env (gitignored): cp example.env .env   Generate secrets: openssl rand -hex 32
# Both secrets are imported into encrypted n8n credentials at container start (entrypoint.sh).
# Convex -> n8n signing secret (must equal Convex env LENDLOOP_WEBHOOK_SECRET)
LENDLOOP_WEBHOOK_SECRET=change-me
# n8n -> Convex signing secret (must equal Convex env N8N_INBOUND_SECRET)
N8N_INBOUND_SECRET=change-me-too
# Convex HTTP actions URL, reachable from the container
CONVEX_SITE_URL=http://host.docker.internal:3211
# Encrypts credentials stored by n8n
N8N_ENCRYPTION_KEY=change-me-as-well
GENERIC_TIMEZONE=UTC
