{
  "id": "llOverdueRemind1",
  "name": "LendLoop – Overdue reminders",
  "active": true,
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 9 * * *"
            }
          ]
        }
      },
      "id": "schedule",
      "name": "Daily 09:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        200
      ]
    },
    {
      "parameters": {},
      "id": "manual",
      "name": "Manual run",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        380
      ]
    },
    {
      "parameters": {
        "operation": "request",
        "path": "/n8n/overdue-loans"
      },
      "id": "fetch-overdue-loans",
      "name": "Fetch overdue loans",
      "type": "CUSTOM.lendLoopHmac",
      "typeVersion": 1,
      "position": [
        220,
        200
      ],
      "credentials": {
        "lendLoopHmacApi": {
          "id": "llCredInbound01",
          "name": "LendLoop inbound secret (n8n to Convex)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "function maskEmail(e) {\n  const [l, d] = String(e || '').split('@');\n  return l && d ? l[0] + '***@' + d : '***';\n}\nfunction logEvent(level, event, fields) {\n  // Reaches docker logs because CODE_ENABLE_STDOUT=true (set in docker-compose.yml).\n  console.log(JSON.stringify({ level, event, ts: new Date().toISOString(), ...fields }));\n}\nconst loans = ($json.loans || []);\nlogEvent('info', 'overdue.fetched', { count: loans.length });\nreturn loans.map((l) => ({ json: l }));"
      },
      "id": "split-loans",
      "name": "Split loans",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "function maskEmail(e) {\n  const [l, d] = String(e || '').split('@');\n  return l && d ? l[0] + '***@' + d : '***';\n}\nfunction logEvent(level, event, fields) {\n  // Reaches docker logs because CODE_ENABLE_STDOUT=true (set in docker-compose.yml).\n  console.log(JSON.stringify({ level, event, ts: new Date().toISOString(), ...fields }));\n}\nconst date = new Date().toISOString().slice(0, 10); // UTC day, matches Convex\nconst l = $json;\n// Logged mock reminder: nothing is actually sent. Recipient address is masked.\nlogEvent('info', 'mock_reminder', {\n  channel: 'mock-log',\n  loanId: l.loanId,\n  to: maskEmail(l.borrower && l.borrower.email),\n  firstName: l.borrower && l.borrower.firstName,\n  subject: 'Reminder: please return ' + (l.tool && l.tool.name) + ' (' + l.daysOverdue + ' day(s) overdue)',\n});\nreturn { json: { loanId: l.loanId, date, channel: 'mock-log', status: 'sent' } };"
      },
      "id": "mock-reminder",
      "name": "Mock reminder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        200
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const j = $json;\nconst body = JSON.stringify({\n  idempotencyKey: 'reminder:' + j.loanId + ':' + j.date,\n  loanId: j.loanId,\n  status: j.status,\n  channel: j.channel,\n});\nreturn { json: { body } };"
      },
      "id": "build-reminder-body",
      "name": "Build reminder body",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ]
    },
    {
      "parameters": {
        "operation": "sign",
        "path": "/n8n/reminder-status",
        "body": "={{ $json.body }}"
      },
      "id": "sign-reminder-status",
      "name": "Sign reminder status",
      "type": "CUSTOM.lendLoopHmac",
      "typeVersion": 1,
      "position": [
        1320,
        200
      ],
      "credentials": {
        "lendLoopHmacApi": {
          "id": "llCredInbound01",
          "name": "LendLoop inbound secret (n8n to Convex)"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.url }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-LendLoop-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.body }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "report-reminder-status",
      "name": "Report reminder status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Daily 09:00": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Manual run": {
      "main": [
        [
          {
            "node": "Fetch overdue loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch overdue loans": {
      "main": [
        [
          {
            "node": "Split loans",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Split loans": {
      "main": [
        [
          {
            "node": "Mock reminder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Mock reminder": {
      "main": [
        [
          {
            "node": "Build reminder body",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build reminder body": {
      "main": [
        [
          {
            "node": "Sign reminder status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sign reminder status": {
      "main": [
        [
          {
            "node": "Report reminder status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "llErrorHandler01"
  },
  "pinData": {},
  "tags": []
}
