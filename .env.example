# ---- Next.js (.env.local) ----
# Convex deployment URL (written by `npx convex dev` into .env.local)
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# ---- Convex deployment env (set with `npx convex env set NAME value`) ----
# Clerk JWT issuer (Clerk dashboard > JWT templates > "convex" template > Issuer)
CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev
# n8n "request-notification" webhook, e.g. http://localhost:5678/webhook/lendloop/request-notification
N8N_WEBHOOK_URL=http://localhost:5678/webhook/lendloop/request-notification
# Convex -> n8n signing secret (generate: openssl rand -hex 32)
LENDLOOP_WEBHOOK_SECRET=replace_me_hex_32_bytes
# n8n -> Convex signing secret (separate from the one above)
N8N_INBOUND_SECRET=replace_me_different_hex_32_bytes
# Optional

# ---- n8n (n8n/.env, see n8n/example.env) ----
# N8N_BLOCK_ENV_ACCESS_IN_NODE and NODE_FUNCTION_ALLOW_BUILTIN are set by docker-compose; do not add them to .env.
# LENDLOOP_WEBHOOK_SECRET, N8N_INBOUND_SECRET (same values as Convex)
# CONVEX_SITE_URL=http://host.docker.internal:3211
# N8N_ENCRYPTION_KEY=replace_me
# N8N_BLOCK_ENV_ACCESS_IN_NODE=false
# NODE_FUNCTION_ALLOW_BUILTIN=crypto
